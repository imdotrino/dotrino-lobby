  "peerDependencies": {
    "@dotrino/proxy-client": ">=0.1.0",
    "@dotrino/identity": ">=0.5.0",
    "@dotrino/reputation": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@dotrino/reputation": { "optional": true }
  },
  "author": "seyacat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-lobby.git"
  }
